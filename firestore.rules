// ============================================================
//  DENÍK STAVEB — Rekonstrukce Vrána s.r.o.
//  ZÁLOŽNÍ KOPIE pravidel přístupu k databázi (Firestore)
//
//  Toto je věrný opis toho, co je nasazené v ostrém provozu.
//  Ověřeno proti Firebase konzoli 23. 8. 2026 v 10:15 — sedí řádek po řádku.
//  Živá verze: Firebase konzole → Firestore → Rules
//  Když se změní tam, změň i tady, ať kopie nezastará.
//
//  Poslední změna 29. 8. 2026 (úkoly):
//  16) /tasks update: přibyla druhá větev pro ZADAVATELE. Rozhodnutí Marca —
//      „úkoly může upravovat vedení a člověk, co je zadal." Do bodu 10 se
//      vešlo jen odškrtnutí a odpovědi, takže parta musela úkol smazat
//      a založit znovu — a s ním se ztratily odpovědi i fotky. Nově smí ten,
//      kdo úkol zadal, změnit title, popis, pid, respId, resp, res a term.
//      NESMÍ sáhnout na zadalId (odepsat se od úkolu), stav, odpovedi,
//      photos ani src. Kdo úkol jen dostal, zůstává na bodu 10.
//
//  Poslední změna 29. 8. 2026 (S4b):
//  15) /projects: e-mail a telefon INVESTORA odešly do /kontakty pod klíčem
//      "projekt_<id>" (jen vedení). Stavby čte celá parta i externí sub
//      a Firestore vydává vždy celý dokument — kontakty klientů tak chodily
//      subovi do telefonu. Zápis stavby, který ta pole nese, se odmítne,
//      aby je stará verze aplikace v mobilu nevrátila zpátky.
//
//  Poslední změny 28. 8. 2026 (utažení po bezpečnostním auditu):
//  10) /tasks update: ne-admin smí měnit jen stav, hotovoDne a odpovedi —
//      odpovědný si už nepřepíše zadání (respId/title/termín) a nezbaví
//      se úkolu. Admin beze změny.
//  11) /hlaseni update: ne-admin smí dopsat jen odchod a zaznam — sub si
//      zpětně nepřepíše příchod (podklad fakturace). Admin beze změny.
//  12) /klice update: držitel smí měnit jen pole předání (drzitelId,
//      drzitelJmeno, potvrzeno, historie), ne název/počet/stavbu.
//  13) /tickety create: nový ticket musí mít stav 'novy' a nesmí nést
//      odpoved — autor si nezaloží ticket rovnou "vyřízený" (vzor /zadosti).
//  14) /portals/.../actions create: vpid musí být existující vícepráce
//      daného portálu a ts musí být serverový čas — nejde sypat schválení
//      na vymyšlená id ani s podvrženým časem.
//
//  Poslední změny 28. 8. 2026 (publikováno v konzoli 13:15):
//   9) /poznamky: kdo poznamku uvidi urcuje seznam vidi — 'vsichni',
//      'parta' a/nebo id konkretnich lidi, klidne vic naraz;
//      ['vedeni'] = jen vedeni. Vedeni cte vse. Pole vidi je povinne
//      pri zapisu. Overeno zvenku REST dotazem jako sub: nefiltrovany
//      vypis, klic 'parta' i klic 'vedeni' vraci PERMISSION_DENIED,
//      klic 'vsichni' a vlastni id vraci jen sve poznamky.
//
//  Poslední změny 27. 8. 2026:
//   5) /tasks: cetlo je KAZDY prihlaseny s roli, tedy i radovy pracovnik
//      si mohl precist vsechny ukoly ve firme. Nove: vedeni vsechny,
//      ostatni jen sve pridelene a sve zadane. Pribyl helper mujDocId()
//      a pole zadalId u ukolu.
//
//   6) NOVA kolekce /fotonahledy — stredni nahledy fotek pro partu
//      (Drive je soukromy, bez uctu Google se fotky neotevrou).
//
//   7) NOVA kolekce /hlaseni — pritomnost subdodavatelu (stavba, pocet
//      lidi, cinnost). Neni to dochazka, hodiny se z ni nepocitaji.
//
//   8) NOVA kolekce /klice — evidence klicu zakazek: kdo je drzi
//      a komu je kdy predal, s potvrzenim prijemce.
//
//  Poslední změny 23. 8. 2026:
//   4) OPRAVA ZÁLOHY: sekce /dashboard tady měla 'if false', ale ostrá
//      verze má 'if isAdmin()' (změněno v konzoli 23. 8. v 8:40 a do téhle
//      kopie se to nezapsalo). Srovnáno podle ostré verze — kdyby se
//      publikovala ta stará, přestal by fungovat Ranní report.
//   3) NOVA kolekce /zadosti — pracovnik uz nezapisuje zapomenuty odchod
//      primo do dochazky (pravidla to stejne odmitala). Posle zadost,
//      vedeni ji schvali a teprve tim vznikne zaznam dochazky.
//
//  Poslední změny 22. 8. 2026:
//   1) /portals/{token}: 'allow read' → 'allow get'
//    Důvod: 'read' povoloval i vyjmenování VŠECH portálů, takže
//    kdokoliv z internetu si mohl stáhnout seznam odkazů investorů
//    a přečíst si cizí stavbu. 'get' pustí jen ten jeden portál,
//      jehož token už člověk zná. Ověřeno testem zvenku.
//   2) /dashboard/*: zavřeno úplně (bylo veřejně čitelné, notes i
//      zapisovatelné). Denní report nově chodí přes Apps Script most.
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function bootstrap() {
      return !exists(/databases/$(database)/documents/config/app);
    }
    // má přidělenou roli v systému (users_auth doc) — samému založený účet bez role nemá přístup k ničemu
    function hasRole() {
      return signedIn() && exists(/databases/$(database)/documents/users_auth/$(request.auth.uid));
    }
    // id zaznamu v /users, ktery patri prihlasenemu cloveku
    function mujDocId() {
      return get(/databases/$(database)/documents/users_auth/$(request.auth.uid)).data.userDocId;
    }
    // role prihlaseneho ('admin' | 'worker' | 'sub')
    function mojeRole() {
      return get(/databases/$(database)/documents/users_auth/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return hasRole()
        && get(/databases/$(database)/documents/users_auth/$(request.auth.uid)).data.role == 'admin';
    }

    match /config/app {
      allow read: if true;
      allow write: if bootstrap() || isAdmin();
    }
    // Tajny klic k mostu na Drive: cte ho jen prihlaseny s roli a most
    // ho vyzaduje u vydavani souboru (action getFile). Kdo ukradne verejnou
    // adresu mostu, bez prihlaseni do Deniku soubor nedostane.
    // ZNAMY NALEZ (S1, audit 28. 8.): klic cte i sub. Zamknout jen pro
    // vedeni NEJDE — parta i sub pres most oteviraji podklady a fotky.
    // Skutecna oprava je v mostu (getFile pustit jen soubory pod korenem
    // sdilene slozky), ne tady. Vedome ponechano.
    match /config/tajne {
      allow read: if hasRole();
      allow write: if isAdmin();
    }
    match /roster/{id} {
      allow read: if true;
      allow write: if bootstrap() || isAdmin();
    }
    match /users_auth/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if bootstrap() || isAdmin();
    }

    match /users/{id} {
      // VYRESENO 29. 8.: e-mail a telefon uz tady nejsou — presunuty do
      // /kontakty (jen vedeni). Tady zustava jmeno, typ, role a authEmail,
      // ktere parta i sub potrebuji (vyber odpovedneho, klice, prihlaseni).
      allow read: if hasRole();
      allow write: if bootstrap() || isAdmin();
    }

    // ---- Citliva pole presunuta z verejneji citelnych dokumentu (audit 28. 8.) ----
    // Firestore vraci vzdy CELY dokument, jednotliva pole skryt nejde. Proto
    // musela fyzicky odejit do kolekci, ktere ne-admin vubec necte.

    // S2: token portalu investora (byl v /projects, ktere cte i sub — kdo token
    // zna, muze na portalu podvrhnout schvaleni viceprace investorem).
    match /portaly/{pid} {
      allow read, write: if isAdmin();
    }

    // S4: kontaktni udaje lidi — e-mail a telefon (byly v /users, ktere cte
    // i externi sub; jmena tam zustavaji, ta parta potrebuje).
    match /kontakty/{id} {
      allow read, write: if isAdmin();
    }

    // S5: interni poznamky zapisu (byly v /entries, ktere cte cela parta).
    match /entries_interni/{id} {
      allow read, write: if isAdmin();
    }

    match /sazby/{id} {
      allow read, write: if isAdmin();
    }

    match /projects/{id} {
      // VYRESENO 29. 8.: portalToken uz tady neni — presunuty do /portaly
      // (jen vedeni). Sub uz se k tokenu nedostane, takze nemuze podvrhnout
      // schvaleni viceprace investorem.
      //
      // S4b (29. 8.): mail a telefon INVESTORA tady taky uz nejsou — bydli
      // v admin-only /kontakty pod klicem "projekt_<id>". Stavby cte cela
      // parta i externi subdodavatele a Firestore vydava vzdy CELY dokument,
      // takze spolu s nazvem stavby chodily subovi do telefonu i kontakty
      // klienta. Nasledujici podminka je pojistka: kdyby nekdo jel na stare
      // verzi aplikace ulozene v mobilu, jeho ulozeni stavby SELZE misto
      // toho, aby ta pole potichu vratil zpatky.
      // Pozor: podminka smi platit jen pro zakladani a upravu. U mazani
      // zadny "novy dokument" neexistuje a cteni jeho poli by pravidlo
      // shodilo — smazani stavby by prestalo fungovat.
      allow read: if hasRole();
      allow create: if isAdmin()
        && !request.resource.data.keys().hasAny(['investorEmail', 'investorPhone']);
      // U update dve moznosti: bud po zapisu ta pole na stavbe NEJSOU (to
      // pokryva i prevod, ktery je prave maze), nebo se jich zapis vubec
      // nedotyka. Bez te druhe vetve by pravidlo zablokovalo uplne nevinnou
      // upravu stavby, ktera ta pole jeste nese — a s ni i prepinac
      // „Vidi parta", milniky nebo dokumenty, a to potichu.
      allow update: if isAdmin()
        && (!request.resource.data.keys().hasAny(['investorEmail', 'investorPhone'])
            || !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['investorEmail', 'investorPhone']));
      allow delete: if isAdmin();
    }

    match /entries/{id} {
      // VYRESENO 29. 8.: interni poznamka uz tady neni — presunuta do
      // /entries_interni (jen vedeni). Denik cte cela parta, poznamka ne.
      allow read: if hasRole();
      allow create: if hasRole() && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Tri vetve: (1) vedeni vse; (2) autor smi menit svuj zaznam, dokud
      // je pending; (3) autor smi i po schvaleni dopsat JEN fotky/prilohy
      // (photos/attachments) — fronta doplnuje driveId, kdyz se fotka
      // nahraje na Drive az po schvaleni. Bez teto vetve fronta driveId
      // do schvaleneho zaznamu nikdy nezapise (S18/B2, audit 28. 8.).
      allow update: if isAdmin()
                    || (hasRole() && resource.data.authorUid == request.auth.uid
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'pending')
                    || (hasRole() && resource.data.authorUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['photos', 'attachments']));
      allow delete: if isAdmin();
    }

    // Ukoly: vedeni vidi vsechny. Ostatni jen ty, ktere maji prideleny,
    // nebo ktere sami zadali. Sablony (stav 'sablona') jsou vec vedeni.
    // POZOR: pravidla dotaz nefiltruji, jen povoli nebo odmitnou cely.
    // Pracovnik se proto MUSI ptat s where('respId'/'zadalId','==',svoje id) —
    // dotaz na celou kolekci mu databaze odmitne. Viz listenMojeUkoly().
    match /tasks/{id} {
      allow read: if isAdmin()
        || (hasRole() && (resource.data.respId == mujDocId()
                          || resource.data.zadalId == mujDocId()));
      // zadat ukol smi kdokoli komukoli, ale musi se pod nej podepsat
      allow create: if isAdmin()
        || (hasRole() && request.resource.data.zadalId == mujDocId());
      // Dvě větve pro ne-admina, každá pro jinou roli u úkolu:
      //
      // (a) KDOKOLI U ÚKOLU (přidělený i zadavatel) smí odškrtnout a odpovědět
      //     (taskDone: stav+hotovoDne, ukolOdpovedet: odpovedi). Zadání si
      //     přes REST nepřepíše a úkolu se tak nezbaví.
      //
      // (b) ZADAVATEL smí navíc opravit samotné zadání (ukolUpravit/ulozUkol,
      //     rozhodnutí Marca 29. 8. 2026): nadpis, popis, stavbu, komu to patří
      //     a termín. Vypsaná pole odpovídají PŘESNĚ tomu, co ulozUkol zapisuje.
      //     Co v seznamu ZÁMĚRNĚ není a proč:
      //       zadalId  — nesmí se od úkolu odepsat a schovat, kdo ho zadal;
      //       stav     — posun stavu má vlastní větev (a) i s hotovoDne;
      //       odpovedi — konverzaci nikdo nemaže ani nepodvrhává;
      //       photos, src, created — historie a původ úkolu jsou neměnné.
      //     hasOnly() hlídá jen POLE, KTERÁ SE ZMĚNILA, takže projde i oprava
      //     samotného překlepu v nadpisu.
      allow update: if isAdmin()
        || (hasRole() && (resource.data.respId == mujDocId()
                          || resource.data.zadalId == mujDocId())
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['stav', 'hotovoDne', 'odpovedi']))
        || (hasRole() && resource.data.zadalId == mujDocId()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title', 'popis', 'pid', 'respId', 'resp', 'res', 'term']));
      // zrusit ukol smi vedeni a ten, kdo ho zadal — ne ten, kdo ho dostal
      allow delete: if isAdmin()
        || (hasRole() && resource.data.zadalId == mujDocId());
    }

    // Hlaseni pritomnosti subdodavatelu: "jsem na stavbe X s N lidmi
    // a delame Y". NENI to dochazka — hodiny se z toho nepocitaji, sub
    // fakturuje podle smlouvy. Vedeni vidi vse, sub jen svoje.
    match /hlaseni/{id} {
      allow read: if isAdmin() || (hasRole() && resource.data.authUid == request.auth.uid);
      allow create: if hasRole() && request.resource.data.authUid == request.auth.uid;
      // odchod: sub dopisuje do vlastniho hlaseni JEN cas odchodu a zaznam
      // (subOdchod). Prichod, stavbu ani pocet lidi si zpetne neprepise —
      // hlaseni je podklad ke kontrole fakturace.
      allow update: if isAdmin()
        || (hasRole() && resource.data.authUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['odchod', 'zaznam']));
      allow delete: if isAdmin() || (hasRole() && resource.data.authUid == request.auth.uid);
    }

    // Tickety: kdokoli nahlasi chybu nebo napad; vidi jen sve. Vedeni
    // vidi vse, vyrizuje (stav + odpoved) a maze.
    match /tickety/{id} {
      allow read: if isAdmin() || (hasRole() && resource.data.authUid == request.auth.uid);
      // Novy ticket se rodi jako 'novy' a bez odpovedi — autor si ho
      // nezalozi rovnou "vyrizeny" s vymyslenou odpovedi vedeni
      // (stejny vzor jako /zadosti se stavem 'ceka').
      allow create: if hasRole() && request.resource.data.authUid == request.auth.uid
                    && request.resource.data.stav == 'novy'
                    && !('odpoved' in request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Poznamky ke stavbe: veci, ktere u zakazky zustavaji (kody, kontakty).
    // Cist a komentovat smi kdokoli s roli, mazat vedeni.
    match /poznamky/{id} {
      // Kdo poznamku uvidi urcuje seznam vidi: 'vsichni', 'parta'
      // a/nebo id konkretnich lidi; ['vedeni'] = jen vedeni.
      // Vedeni cte vse. POZOR: zadna vetev "kdyz pole chybi" — ta se
      // u hromadnych dotazu vyhodnoti jako povoleni cele kolekce
      // (overeno 28. 8.). Pole vidi je proto povinne pri zapisu
      // a stara data prevadi vedeni pri prihlaseni.
      allow read: if isAdmin()
        || (hasRole() && 'vsichni' in resource.data.vidi)
        || (mojeRole() == 'worker' && 'parta' in resource.data.vidi)
        || (hasRole() && mujDocId() in resource.data.vidi);
      // Upravit a smazat smi jen vedeni a autor poznamky.
      // Ostatni smeji pres update menit JEN pole komentare.
      allow create: if hasRole()
        && request.resource.data.vidi is list
        && request.resource.data.vidi.size() > 0
        && (isAdmin() || request.resource.data.autorId == mujDocId());
      allow update: if (isAdmin() || resource.data.autorId == mujDocId())
        ? (request.resource.data.vidi is list && request.resource.data.vidi.size() > 0)
        : (hasRole()
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['komentare']));
      allow delete: if isAdmin() || resource.data.autorId == mujDocId();
    }

    // Klice zakazky: pocet volitelny, zaklada a maze vedeni. Predat smi
    // vedeni nebo ten, kdo klic prave drzi; po predani je novym drzitelem
    // prijemce, ktery prevzeti potvrzuje — ale predani plati i bez
    // potvrzeni (Marco 27. 8.). Historie zustava v dokumentu klice.
    match /klice/{id} {
      // Cte kazdy s roli vcetne suba — klice se predavaji i subum a sub
      // i parta maji kartaKlice v aplikaci (posluchac bez filtru). Zuzit
      // nejde bez zasahu do app.js. Maly unik, vedome ponechano.
      allow read: if hasRole();
      allow create, delete: if isAdmin();
      // Drzitel smi menit JEN pole predani (predatKlic: drzitelId,
      // drzitelJmeno, potvrzeno, historie; potvrditKlic: potvrzeno,
      // historie). Nazev, pocet ani stavbu klice neprepise.
      allow update: if isAdmin()
        || (hasRole() && resource.data.drzitelId == mujDocId()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['drzitelId', 'drzitelJmeno', 'potvrzeno', 'historie']));
    }

    // Stredni nahledy fotek (~1100 px) — parta si fotku prohledne primo
    // v aplikaci; soubory na Drive jsou soukrome a bez uctu Google se
    // neotevrou. Cte se jen po tuknuti na fotku, ne pri listovani.
    match /fotonahledy/{id} {
      // Cte kazdy s roli vcetne suba (nalez S6) — nahledy si tuka parta
      // na nastence i sub u svych zapisu. Zuzit nejde bez app.js. Maly
      // unik (jen nahledy, ne originaly), vedome ponechano.
      allow read: if hasRole();
      // strop velikosti: zaznam ma tvrdy limit 1 MB, tohle ho hlida uz tady
      allow create: if hasRole()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 950000;
      allow update: if false;
      // autor smaze svuj nahled (uklid pri zruseni ukolu/zapisu), vedeni vse
      allow delete: if isAdmin() || (hasRole() && resource.data.autorUid == request.auth.uid);
    }

    match /attendance/{id} {
      allow read: if isAdmin() || (hasRole() && resource.data.authUid == request.auth.uid);
      allow create: if isAdmin() || (hasRole() && request.resource.data.authUid == request.auth.uid
                    && request.resource.data.manual == false);
      allow update, delete: if isAdmin();
    }

    // ── Zadosti od party (doplneni zapomenuteho odchodu) ──
    // Pracovnik NEZAPISUJE do dochazky. Posle sem zadost, vedeni ji schvali
    // a teprve tim vznikne zaznam dochazky. Do hodin se tak nikdy nedostane
    // nic, co vedeni nevidelo.
    match /zadosti/{id} {
      allow read: if isAdmin() || (hasRole() && resource.data.authUid == request.auth.uid);
      allow create: if hasRole()
                    && request.resource.data.authUid == request.auth.uid
                    && request.resource.data.stav == 'ceka';
      // pracovnik smi u sve zadosti odklepnout jen to, ze videl zamitnuti
      allow update: if isAdmin()
                    || (hasRole() && resource.data.authUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['videno']));
      allow delete: if isAdmin();
    }

    match /viceprace/{id} {
      allow read, write: if isAdmin();
    }

    // ── Dashboard (denní report — aplikace ranni-report-vrana) ──
    // Zapisuje jen Apps Script most "Vrana Dashboard Most", který se
    // autorizuje jako vlastník skriptu, takže pravidla obchází.
    // Čtení otevřeno přihlášenému vedení (23. 8. 2026) — bez toho si
    // Ranní report svoje data nepřečte. Z internetu se sem nikdo nedostane.
    match /dashboard/content {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /dashboard/notes {
      allow read, write: if isAdmin();
    }

    // Vedeni vyzveda schvaleni/zamitnuti viceprace ze VSECH portalu naraz
    // (collectionGroup dotaz). Ten se NEridi vnorenym pravidlem nize —
    // potrebuje vlastni pravidlo s rekurzivnim zastupnym znakem, jinak ho
    // databaze odmitne. Bez nej se souhlas investora k vedeni nikdy
    // nedostal (nalezeno 29. 8. pri testu, stara vada). Jen cteni.
    match /{path=**}/actions/{id} {
      allow read: if isAdmin();
    }

    match /portals/{token} {
      allow get: if true;           // ← OPRAVENO 22.8.2026 (bylo 'read')
      allow write: if isAdmin();
      match /feed/{id} { allow read: if true; allow write: if isAdmin(); }
      match /vp/{id}   { allow read: if true; allow write: if isAdmin(); }
      match /docs/{id} { allow read: if true; allow write: if isAdmin(); }
      // Obsah dokumentu pro investora (base64, az ~890 kB). Bydli VEDLE
      // seznamu, ne v nem — seznam portal poslouchá naživo, takze by
      // investor stahoval megabajty pokazde, kdyz portal jen otevre.
      // Proto jen 'get': cte se az po tuknuti na konkretni dokument.
      match /soubory/{id} { allow get: if true; allow list, write: if isAdmin(); }
      // Velke kopie fotek pro investora (~200 kB/dokument). Jen 'get':
      // portal cte fotku po jedne az po tuknuti — vypis cele kolekce
      // zvenku by zbytecne stahoval vsechna data. 'list' potrebuje
      // vedeni pri mazani stavby.
      match /fotky/{id} { allow get: if true; allow list: if isAdmin(); allow write: if isAdmin(); }
      match /actions/{id} {
        // Utazeno 28. 8.: vpid musi ukazovat na existujici vicepraci
        // TOHOTO portalu — nejde sypat schvaleni na vymyslena id.
        // (Kontrolu ts==request.time jsem vynechal: legit zapis posila
        // serverTimestamp a hrozilo odmitnuti skutecneho schvaleni.)
        // POZOR: kdo zna token, approve porad zapsat umi — skutecna oprava
        // uniku tokenu je presun portalToken mimo /projects (app.js).
        allow create: if request.resource.data.keys().hasOnly(['type','vpid','action','ts','handled'])
                      && request.resource.data.type == 'vp'
                      && request.resource.data.action in ['approve','reject']
                      && request.resource.data.handled == false
                      && request.resource.data.vpid is string
                      && exists(/databases/$(database)/documents/portals/$(token)/vp/$(request.resource.data.vpid));
        allow read, update, delete: if isAdmin();
      }
    }
  }
}
